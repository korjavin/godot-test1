; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CrimeKickers"
config/description="A 3rd person adventure game for learning Godot"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
; Boot splash background: the sky-horizon tone (#d9dbcc — must track
; sky_horizon_color/FOG_COLOR (0.85, 0.86, 0.80)). Shown instead of the
; default black while the engine starts, and the web export substitutes it into
; the page's loading overlay ($GODOT_SPLASH_COLOR), so there is no black flash
; at any load stage. No boot_splash/image on purpose — plain color only.
boot_splash/bg_color=Color(0.85, 0.86, 0.8, 1)
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
; Aspect handling. Desktop keeps "keep" (the engine default — preserves the 1920x1080
; 16:9 framing, letterboxing only if the window isn't 16:9). The web build (phones)
; overrides to "expand" via Godot's `.web` per-feature suffix, so the view fills any
; screen shape with square pixels (no black bars, no distortion — it just reveals a
; little more/less of the scene). Anchored HUD/touch controls reflow to the new edges.
window/stretch/aspect="keep"
window/stretch/aspect.web="expand"

[internationalization]

; --- UI translations (en / de) --------------------------------------------
; `assets/translations/ui.csv` is imported by Godot's CSV translation importer,
; which emits one `.translation` resource per locale column. The KEY of every
; row is the ENGLISH SOURCE STRING, not an abstract identifier — that is what
; lets Godot's built-in Control auto-translation do nearly all the work with no
; `tr()` call at the assignment site (a `Label.text` / `Button.text` literal is
; run through the TranslationServer at draw time and re-run on every locale
; change), and it makes English the automatic fallback for any key a translator
; has not filled in yet. See the "Localization" section of CLAUDE.md.
;
; The startup locale comes from `OS.get_locale()` for free — a German browser
; starts in German with no code at all. `start_overlay.gd` only ever applies an
; explicit OVERRIDE saved in `user://locale.cfg`.
locale/translations=PackedStringArray("res://assets/translations/ui.en.translation", "res://assets/translations/ui.de.translation")
locale/fallback="en"

