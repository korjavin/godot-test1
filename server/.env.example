# ===========================================
# Godot lobby + TURN — Portainer stack variables
# ===========================================
# Set these as environment variables on the Portainer stack, not in a file on the
# server. Every one of them has a default in docker-compose.yml except the four
# marked REQUIRED.

# --- Docker images ---
# CI rewrites this tag to the commit SHA on the `deploy` branch; leave `latest`
# here on master.
LOBBY_IMAGE=ghcr.io/korjavin/godot-test1-lobby:latest
COTURN_IMAGE=coturn/coturn:4.6-alpine

# --- Container names ---
LOBBY_CONTAINER_NAME=godot-lobby
COTURN_CONTAINER_NAME=godot-coturn

# --- Traefik ---
TRAEFIK_NETWORK_NAME=traefik_default
TRAEFIK_CERTRESOLVER=myresolver
# REQUIRED — the hostname clients reach the lobby on: wss://LOBBY_HOST/ws
LOBBY_HOST=lobby.example.com

# --- Lobby ---
# Comma-separated websocket origin patterns, or * for any page. Narrow this to
# the game's host once the client is deployed, e.g.
#   LOBBY_ALLOWED_ORIGINS=korjavin.github.io
LOBBY_ALLOWED_ORIGINS=*

# --- TURN / STUN (served to clients by GET /ice) ---
STUN_URL=stun:stun.l.google.com:19302
# REQUIRED — must resolve to the public IP of this host.
TURN_URL=turn:turn.example.com:3478
TURN_REALM=turn.example.com
TURN_USER=godot
# REQUIRED — generate with: openssl rand -hex 24
TURN_PASSWORD=change-me
# RECOMMENDED — set this and /ice stops handing out TURN_USER/TURN_PASSWORD.
# /ice is unauthenticated (the game build cannot hold a secret) and CORS is
# browser-only, so anyone who curls it gets the relay; with a secret it gets a
# credential that expires in 24 h instead of never. coturn switches to
# --use-auth-secret in the same breath, so the static pair above stops
# authenticating — set both halves at once, and keep the value alphanumeric
# (the coturn image evals each argument). Generate with: openssl rand -hex 32
TURN_SECRET=
# REQUIRED — the server's public IPv4 address. coturn advertises relay candidates
# on this address, so a wrong value produces candidates nobody can reach.
TURN_EXTERNAL_IP=203.0.113.10

# The relay port range must be open in the host firewall (UDP), along with
# TURN_LISTEN_PORT on both TCP and UDP.
TURN_LISTEN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# --- Sign-in (magic link; server/auth.go) ---
# Sessions + anon->sub aliases dump here every 30 s; unset and they live only
# as long as the container. Pending links stay in memory either way.
LOBBY_AUTH_FILE=/data/auth.json
# Where GET /auth/verify?t= lands after minting a session, the session riding
# a #session= fragment: the game build's URL on its own host.
AUTH_GAME_URL=https://korjavin.github.io/godot-test1/
# Outbound relay for the sign-in mails. Empty host (and no dev flag) means
# POST /auth/magic answers 503 — sign-in simply off.
SMTP_HOST=
# Plain SMTP+STARTTLS, except 465 which dials TLS directly.
SMTP_PORT=587
# Auth is skipped when empty (open relay / local catcher).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=CrimeKickers
# LOCAL-ONLY: log the link instead of mailing it, for `go run .` end-to-end.
# Never set this on a deployment — the log would hold live sign-in links.
# AUTH_DEV_LOG_LINK=1
