# Godot 4+ specific ignores
.godot/
.import/

# Godot-specific files
*.translation
*.import

# Build outputs
build/
builds/
dist/
exports/

# Mono/C# (if using C# in future)
.mono/
data_*/
mono_crash.*.json

# System/tool-specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE specific files
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Logs and temporary files
*.log
logs/
*.tmp

# Android build files (if exporting to Android)
.gradle/
local.properties
*.apk
*.aab

# iOS build files (if exporting to iOS)
*.dSYM.zip
*.ipa
ios/

# Web export (generated files)
.web/
*.wasm.map

# Backup files
*.backup
*.bak
*~

# OS generated files
.directory

# Don't ignore export_presets.cfg - we want this in version control
# so CI/CD can use it
!export_presets.cfg

# Godot addons — the desktop-only WebRTC GDExtension (webrtc-native) is fetched
# by ./fetch_webrtc_addon.sh from a pinned release, never vendored (37 MB of
# binaries, MPL-2.0 bundled libs). The web build needs no addon at all, and the
# Web export preset excludes addons/* so an installed one cannot reach it.
addons/
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Python bytecode from the model generator scripts
__pycache__/

# ralphex run artifacts
.ralphex/

# The vendored face detector (bead godot-test1-xtr.12) is FETCHED AT BUILD TIME
# by scripts/fetch_vendor.sh against web/vendor/mediapipe/vendor.lock, never
# committed: it is ~12 MB of binaries, and a binary in history is permanent
# weight on every clone and every CI checkout. The lock, the LICENSE and the
# README stay in git — they are what the fetch is driven by.
web/vendor/mediapipe/vision_bundle.js
web/vendor/mediapipe/wasm/
web/vendor/mediapipe/*.tflite
