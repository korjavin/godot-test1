[node name="Mesh" parent="Body" instance=ExtResource("1_body")]

; THE SWORDS ARE A BoneAttachment3D, AND THEY ARE DATA. Two sheathed katanas
; crossed in an X on his back, built by `scripts/generate_primm_swords.py` —
; rigid geometry the skeleton carries, never skinned. `player_abilities.gd`
; has never looked this node up — there is no iaido here, they are set
; dressing the chest bone carries — so hanging them is a scene edit and
; nothing else.
;
;   * `use_external_skeleton`, NOT editable children, and that is the "survives
;     a re-import" half of the bead's question: the fan's reasoning in
;     `windman_updated.tscn` holds here word for word — an external skeleton
;     is ONE NodePath resolved at run time, which a rebuilt .glb either still
;     answers or fails loudly on. `build_hero.py` names the armature, so
;     `Armature/Skeleton3D` is stable across rebuilds.
;   * The OFFSET lives on the child, never on the attachment: BoneAttachment3D
;     overwrites its own transform with the bone's pose every frame (the
;     `CameraArm` rule in CLAUDE.md, same failure mode).
;   * The basis is MEASURED, not guessed, and it maps the prop frame into the
;     chest frame: `spine_03` rests with x (-1.0000, 0.0000, 0.0000),
;     y (0.0000, 0.9750, 0.2222), z (0.0000, 0.2222, -0.9750) — read off
;     `Skeleton3D.get_bone_global_rest()` on the shipped scene by a headless
;     probe, which is also where the numbers below come from. The prop is
;     authored trimesh Z-up with +Y front (the fan's convention); at rest its
;     +Z must stand on world UP and its +Y on world FRONT, i.e. Godot's -Z.
;     So the columns below are the prop's axes in the bone's frame — +Z on
;     world up, +Y on world -Z — and the X sits flat on the shoulder blades
;     with the hilts up past the shoulders and the tips splayed past the coat
;     tails. Expressed in the BONE's frame, so it is not a world lock: the
;     pair rides the chest every time he leans, which is what the stride
;     frames are for.
;   * The 20 cm up / 9 cm back off the bone's origin is the X crossing:
;     world (0, 1.32, 0.150) at rest. The 30° tilt and the 0.72 m saya put the
;     hilts up past the shoulders (~1.54) and the tips down at hip height
;     (±0.36, 0.70, 0.15) — splayed 15 cm past the coat's x-range, just behind
;     its back plane. Nearest approach 146 mm to the coat volume, 200 mm to any
;     body vertex, measured headless on the shipped scene (`primm_swords_selfcheck`
;     asserts > 5 mm; the bead's report carries the full numbers).
;
[node name="Swords" type="BoneAttachment3D" parent="Body"]
bone_name = "spine_03"
use_external_skeleton = true
external_skeleton = NodePath("../Mesh/Armature/Skeleton3D")

[node name="Mesh" parent="Body/Swords" instance=ExtResource("2_swords")]
transform = Transform3D(-1, 0, 0, 0, -0.2222, 0.975, 0, 0.975, 0.2222, 0.0001, 0.1993, -0.0903)

; THE HAND KATANAS ARE DATA TOO (bead godot-test1-0mr0.3): one DRAWN blade per
; hand for the 0.5 s Twin Flash, hidden unless the slash runs. Same rules as
; the back pair above — `use_external_skeleton`, offset on the CHILD, basis
; MEASURED on the shipped scene, never guessed:
;
;   * The prop frame is the pair's (tip at -Z, hilt at +Z). The grip puts the
;     hilt in the palm: prop +Z rides the hand bone's -Y (the wrist way), prop
;     +X rides the hand's +X, det +1 measured. The child translation seats the
;     palm 15 cm up the hilt from the guard.
;   * At rest the blades hang ~45 deg down-forward, tips 0.49 m off the ground
;     and 26 cm outboard of the legs — measured headless, no clip. Mid-cross
;     the two metre-long blades CAN interpenetrate: 0.5 s under a white disc,
;     nobody tracks that continuity, and the code says so too.
;   * `visible = false` is the sheathed state. `player_abilities.gd` swaps the
;     three visibilities for exactly the slash window (and the remote mirror
;     does the same off the `ab` bit); expiry and `_reset_ability_states()` put
;     them back. A hero without these nodes is a no-op, never an error.
[node name="SwordL" type="BoneAttachment3D" parent="Body"]
visible = false
bone_name = "hand_l"
use_external_skeleton = true
external_skeleton = NodePath("../Mesh/Armature/Skeleton3D")

